{
  "name": "playwright-js-e2e-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:ui": "npx cucumber-js tests/ui/features --require tests/ui/steps --format json:reports/ui-report.json",
    "test:api": "npx cucumber-js tests/api/features --require tests/api/steps --format json:reports/api-report.json",
    "test:mobile": "npx cucumber-js tests/mobile/features --require tests/mobile/steps --format json:reports/mobile-report.json",
    "test:all": "npm run test:ui && npm run test:api && npm run test:mobile && npm run test:performance",
    "bdd": "npx cucumber-js tests/features/**/*.feature --require tests/step-definitions/**/*.js --format html:reports/cucumber-report.html",
    "report:generate": "allure generate reports --clean -o allure-report",
    "test:cucumber": "npx cucumber-js",
    "test:performance": "node tests/specs/lighthouse.spec.js",
    "report:open": "allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.1.0",
    "cucumber-html-reporter": "^7.2.0",
    "cucumber-pretty": "^6.0.1",
    "eslint": "^9.31.0",
    "lighthouse": "^12.8.2"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.1.0",
    "axios": "^1.12.2",
    "chai": "^6.2.0",
    "dotenv": "^17.2.3",
    "mocha": "^11.7.4"
  }
}
